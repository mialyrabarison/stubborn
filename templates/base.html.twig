<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body>
        <header>
            <div class="identite">
                <img src="{{ asset('images/Logo.png') }}" alt="Logo Stubborn">
                <p class="slogan">Affirmez Vos Styles</p>
                
            </div>
            {# Titre affiché uniquement dans le back-office #}
            {% if app.request.attributes.get('_route') starts with 'app_admin' %}
                <h1 class="titre-back-office">Back-Office</h1>
            {% endif %}

            
            <nav>
                {% if app.request.attributes.get('_route') starts with 'app_admin' %}

                    {# Menu réservé au back-office #}
                    <a href="{{ path('app_products') }}">Boutique</a>
                    <a href="{{ path('app_logout') }}">Se déconnecter</a>

                {% else %}

                    {# Menu normal de la boutique #}
                    <a href="{{ path('app_home') }}"
                    class="{{ app.request.attributes.get('_route') == 'app_home' ? 'actif' : '' }}">
                        Accueil
                    </a>

                    {% if app.user %}
                        {# Menu pour un client connecté #}

                        {# Boutique : lien fonctionnel et soulignement de la page active #}
                        <a href="{{ path('app_products') }}"
                        class="menu-boutique {{ app.request.attributes.get('_route') == 'app_products' ? 'actif' : '' }}">
                            Boutique
                        </a>

                        {# Panier : lien fonctionnel et soulignement de la page active #}
                        <a href="{{ path('app_cart') }}"
                        class="menu-panier {{ app.request.attributes.get('_route') == 'app_cart' ? 'actif' : '' }}">
                            Panier
                        </a>

                        <a href="{{ path('app_logout') }}">Se déconnecter</a>
                    {% else %}
                        {# Menu pour un visiteur non connecté #}
                        <a href="{{ path('app_register') }}">S'inscrire</a>
                        <a href="{{ path('app_login') }}">Se connecter</a>
                    {% endif %}

                {% endif %}
            </nav>


            {# Menu provisoire pour un utilisateur non connecté. #}

        </header>

                    {# Conserve l'emplacement du contenu propre à chaque page. #}
            {% block body %}{% endblock %}

            {# Lien de retour réservé à l'administrateur dans la Boutique #}
            {% if is_granted('ROLE_ADMIN') and app.request.attributes.get('_route') == 'app_products' %}
                <div class="retour-admin">
                    <a href="{{ path('app_admin') }}">
                        ← Retour au Back-Office
                    </a>
                </div>
            {% endif %}


        <footer>
            <h3>Informations de la société</h3>
            <p>Nom de la société : Stubborn</p>
            <p>Adresse : Piccadilly Circus, London W1J 0DA, Royaume-Uni</p>
            <p>Adresse de contact : stubborn@blabla.com</p>
        </footer>

    </body>
</html>
